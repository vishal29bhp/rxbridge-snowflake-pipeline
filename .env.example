# Copy to .env and fill in. .env is git-ignored: never commit it.

# ---- Azure Blob Storage ----
# Portal > Storage account > Security + networking > Access keys > Connection string
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT=yourstorageaccount
AZURE_CONTAINER=rx-archive
# Portal > Microsoft Entra ID > Overview > Tenant ID  (used by 00_admin_setup.sql)
AZURE_TENANT_ID=
# Only for 90_automation.sql: the Storage Queue that Event Grid writes to
AZURE_QUEUE=rx-blob-events

# ---- Azure AI Document Intelligence ----
# Portal > your Document Intelligence resource > Keys and Endpoint
AZURE_DI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DI_KEY=
RX_READER=azure                 # azure | offline (Tesseract on your laptop, free)
RX_EXTRACT_MODEL=prebuilt-read
RX_VERIFY_MODEL=prebuilt-layout

# ---- Snowflake ----
# Account identifier, e.g. abc12345.central-india.azure  (Snowsight > account menu > Account details)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# Use ONE of these two. Key pair is recommended; password is fine for a trial.
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=RX_ENGINEER
SNOWFLAKE_WAREHOUSE=RX_LOAD_WH
SNOWFLAKE_DATABASE=RX_DB
# dbt target: dev (password) or dev_keypair (private key)
DBT_TARGET=dev
DBT_WAREHOUSE=RX_TRANSFORM_WH

# ---- Batch rules (walkthrough values; production: RX_MIN_READY=5000) ----
RX_BATCH_SIZE=5000
RX_PAGE_BUDGET=15000
RX_MIN_READY=1
RX_MAX_WAIT_HOURS=6
RX_MAX_ACTIVE_BATCHES=4
RX_MAX_ATTEMPTS=2
